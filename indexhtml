// lesson
const U=[["الدولة الأموية (٤١–١٣٢هـ)", "قامت الدولة الأموية بعد انتهاء عصر الخلفاء الراشدين، وامتد حكمها حوالي ٩١ عامًا. اتسعت فيها الفتوحات، وتطور نظام الحكم والإدارة، وازدهرت العلوم والعمارة.", "كم عامًا امتد حكم الدولة الأموية؟ (حوالي ٩١ عامًا)", ["🕌 العاصمة دمشق", "⚔️ اتساع الفتوحات", "🏛️ تطور الإدارة", "📚 ازدهار العلوم والعمارة"]], ["معاوية بن أبي سفيان (٤١–٦٠هـ)", "أول خلفاء الدولة الأموية. من أعماله: اتخذ دمشق عاصمة للأمويين، واهتم بالبحرية الإسلامية، وأنشأ مدينة القيروان لنشر الإسلام في شمال إفريقيا، وأسس ديوان الخاتم لحماية رسائل الدولة من التزوير.", "ما المدينة التي أنشأها معاوية في شمال إفريقيا؟ (القيروان)", ["🏙️ دمشق عاصمة", "⚓ البحرية الإسلامية", "🕌 القيروان", "📜 ديوان الخاتم"]], ["عبد الملك بن مروان (٦٥–٨٦هـ)", "استقرت الدولة الإسلامية في عهده بعد فترة من الفوضى والصراعات. من أعماله: سك أول عملة إسلامية، وأمر بنقط المصحف لتسهيل قراءة القرآن الكريم، وشيّد مسجد قبة الصخرة في فلسطين، وعرّب الدواوين للغة العربية.", "ما فائدة نقط المصحف الشريف؟ (تسهيل قراءة القرآن الكريم)", ["💰 أول عملة إسلامية", "📖 نقط المصحف", "🕌 قبة الصخرة", "📝 تعريب الدواوين"]], ["الوليد بن عبد الملك (٨٦–٩٦هـ)", "تميز عهده بالرخاء الاقتصادي وانتشار الأمن والاستقرار. واصل الفتوحات شرقًا إلى بلاد السند وغربًا إلى بلاد الأندلس، وبلغت الدولة أقصى اتساعها. أعاد بناء المسجد النبوي ووسّع الحرم المكي، وشيّد المسجد الأموي في دمشق.", "أين شيّد الوليد المسجد الأموي؟ (في دمشق)", ["🌍 السند والأندلس", "🕌 المسجد الأموي", "🕋 توسعة الحرم المكي", "💎 رخاء واستقرار"]], ["عمر بن عبد العزيز (٩٩–١٠١هـ)", "أُطلق عليه خامس الخلفاء الراشدين لعدله وزهده وحرصه على مصلحة الأمة. اختار القضاة والولاة ممن عُرفوا بحسن السيرة والعدل، ونشر الإسلام بالقدوة والموعظة الحسنة، واهتم بالعلم والعلماء وشيّد المدارس. وفي خلافته لم يكن هناك فقراء، حتى إن عمّال الزكاة لم يجدوا من يأخذها.", "لماذا يُعد عمر بن عبد العزيز قدوة في الحكم؟ (لعدله وزهده وحرصه على مصلحة الأمة)", ["⚖️ العدل", "🌿 الزهد", "🏫 بناء المدارس", "🤝 اختيار الولاة الصالحين"]], ["أسباب ضعف وسقوط الدولة الأموية", "١) تولي خلفاء ضعفاء في أواخر عهدها. ٢) كثرة الصراعات بين القبائل العربية على السلطة. ٣) ظهور الدعوة العباسية على يد أبي مسلم الخراساني. وقامت الدولة العباسية بعد هزيمة الأمويين في معركة الزاب الكبرى عام ١٣٢هـ.", "ما المعركة التي هُزم فيها الأمويون؟ (معركة الزاب الكبرى)", ["👑 خلفاء ضعفاء", "⚔️ صراع القبائل", "📣 الدعوة العباسية", "🏁 معركة الزاب ١٣٢هـ"]], ["بداية الدولة العباسية (١٣٢–٦٥٦هـ)", "تنقسم إلى عصرين: الأول (الذهبي) بقوة الخلفاء وازدهار العلوم والثقافة، والثاني عصر الضعف والانقسام. أبو العباس عبد الله (١٣٢–١٣٦هـ) وضع أسس الدولة ونقل العاصمة إلى الأنبار. وأبو جعفر المنصور (١٣٦–١٥٨هـ) هو المؤسس الحقيقي، قضى على الثورات ونشر الأمن وبنى بغداد وجعلها عاصمة الخلافة.", "من المؤسس الحقيقي للدولة العباسية؟ (أبو جعفر المنصور)", ["🌟 العصر الذهبي", "🏗️ الأنبار", "🏙️ بناء بغداد", "🛡️ القضاء على الثورات"]], ["الرشيد والمأمون والمعتصم", "هارون الرشيد (١٧٠–١٩٣هـ) أشهر الخلفاء العباسيين، أسس بيت الحكمة وسوق الوراقين وأقام علاقات قوية مع ملوك أوروبا. المأمون (١٩٨–٢١٨هـ) شجع ترجمة الكتب ودعم العلماء وأنشأ أول مرصد فلكي. المعتصم (٢١٨–٢٢٧هـ) بنى جيشًا قويًا وأنشأ سامراء وفتح عمورية.", "من أسس مكتبة بيت الحكمة؟ (هارون الرشيد)", ["📚 بيت الحكمة", "🔭 أول مرصد فلكي", "🌐 حركة الترجمة", "🏰 سامراء وعمورية"]], ["سقوط الدولة العباسية", "١) الصراع بين الأمراء العباسيين على الحكم. ٢) ضعف الخلفاء في نهاية العصر العباسي الثاني. ٣) سيطرة العناصر غير العربية على نظم الحكم. وأدى ذلك إلى سقوطها على يد المغول سنة ٦٥٦هـ بعد أن استمرت أكثر من خمسة قرون. وتعلمنا أن التقدم يأتي من خلال العدل والاجتهاد.", "متى سقطت الدولة العباسية؟ (سنة ٦٥٦هـ)", ["⚔️ صراع الأمراء", "📉 ضعف الخلفاء", "🔄 سيطرة غير العرب", "🐎 غزو المغول ٦٥٦هـ"]]];
