// game
let gi=0,seq=[],g2=0,g2t=0,g3=null;
function drawGame(){const done=S.g.s.filter(Boolean).length;$('#gp').style.width=done/3*100+'%';
 $('#gsum').textContent=`النقاط: ${S.g.pts} — الإجابات الصحيحة: ${S.g.ok} — المرحلة ${Math.min(gi+1,3)} من 3`;
 const b=$('#gbox');gi=S.g.s.findIndex(x=>!x);
 if(gi<0){pushScore();b.innerHTML=`<div style="text-align:center"><div style="font-size:3rem">⭐⭐⭐</div><h3>أحسنت يا ${S.name}!</h3><p class="lead">أكملت المراحل الثلاث. نقاطك: ${S.g.pts}، وإجاباتك الصحيحة: ${S.g.ok}.</p><button class="btn" data-go="6">انتقل إلى الاختبار النهائي</button> <button class="btn gh" id="gre">إعادة اللعبة</button></div>`;$('#gre').onclick=()=>{S.g={s:[0,0,0],pts:0,ok:0};g2=0;seq=[];g3=null;save();drawGame()};return}
 if(gi===0){b.innerHTML=`<h3>المرحلة 1: رتّب العصور التاريخية</h3><p class="lead">اضغط العصور بالترتيب من الأقدم للأحدث.</p><p style="font-size:1.4rem;min-height:40px">${seq.join(' ← ')||'…'}</p><div style="display:flex;gap:8px;flex-wrap:wrap">${['🕋 الخلافة الراشدة','🌙 الدولة الأموية','🕌 الدولة العباسية'].map(c=>`<button class="chip" ${seq.includes(c)?'disabled':''}>${c}</button>`).join('')}<button class="btn gh" id="gc">مسح</button></div><p class="say" id="gm"></p>`;
  b.querySelectorAll('.chip').forEach(c=>c.onclick=()=>{seq.push(c.textContent);if(seq.length<3)return drawGame();
   if(seq[0].includes('الراشدة')&&seq[1].includes('الأموية')&&seq[2].includes('العباسية')){S.g.s[0]=1;S.g.pts+=10;S.g.ok++;seq=[];save();toast('رائع! ترتيب صحيح 🎉');drawGame()}else{seq=[];drawGame();$('#gm').textContent='تلميح: بعد الخلفاء الراشدين قامت الدولة الأموية ثم العباسية.'}});
  $('#gc').onclick=()=>{seq=[];drawGame()}}
  else if(gi===1){const K=[['a','معاوية بن أبي سفيان','أول خلفاء الأمويين واتخذ دمشق عاصمة.','اتخذ دمشق عاصمة وأسس ديوان الخاتم.'],['b','أبو جعفر المنصور','المؤسس الحقيقي للدولة العباسية وبانِي بغداد.','بنى مدينة بغداد وجعلها عاصمة الخلافة.'],['c','المأمون','اهتم بالعلم والفلك وأنشأ أول مرصد.','اهتم بالفلك وأنشأ أول مرصد فلكي.']];
  const k=K[g2];b.innerHTML=`<h3>المرحلة 2: من هو الخليفة (${g2+1}/3)</h3><p class="say" style="font-size:1.1rem">🔎 ${k[3]}</p>${shuf(K).map(o=>`<button class="opt" data-k="${o[0]}">${o[1]}</button>`).join('')}<p class="say" id="gm"></p>`;
  b.querySelectorAll('.opt').forEach(o=>o.onclick=()=>{if(o.dataset.k===k[0]){if(!g2t){S.g.pts+=10;S.g.ok++}g2t=0;toast('صح! '+k[2]);if(++g2>=3){S.g.s[1]=1}save();drawGame()}else{g2t=1;o.classList.add('no');$('#gm').textContent='حاول تاني. تلميح: '+k[2]}})}
 else{if(!g3)g3=mixed(PHS);b.innerHTML=`<h3>المرحلة 3: تحدي الخلفاء العباسيين</h3><p class="lead">رتّب الخلفاء العباسيين من الأقدم للأحدث.</p><ol class="ord" id="go"></ol><button class="btn" id="gk">تحقق من الترتيب</button><p class="say" id="gm"></p>`;ordList($('#go'),g3);
  $('#gk').onclick=()=>{if(g3.every((x,i)=>x===PHS[i])){S.g.s[2]=1;S.g.pts+=20;S.g.ok++;save();toast('ترتيب ممتاز! 🌟');drawGame()}else $('#gm').textContent='لسه فيه ترتيب غلط. تلميح: ابدأ بأبي العباس السفاح وانتهِ بالمعتصم.'}}}

// quiz
const MC=[['ما عاصمة الدولة الإسلامية في العصر الأموي؟','دمشق','المدينة','الكوفة','اتخذ معاوية دمشق عاصمة للأمويين.',1],
['من الخليفة الذي بنى مدينة بغداد؟','أبو جعفر المنصور','الوليد بن عبد الملك','مروان بن محمد','بناها المنصور وجعلها عاصمة الخلافة.',6],
['قام الخليفة ........ ببناء مدينة سامراء.','المعتصم بالله','الأمين','أبو العباس','أنشأها المعتصم لتكون مقرًا للخلافة.',7],
['من قام بتعريب الدواوين في الدولة الإسلامية؟','عبد الملك بن مروان','معاوية بن أبي سفيان','عمر بن عبد العزيز','عرّب عبد الملك الدواوين للغة العربية.',2],
['من لُقّب بخامس الخلفاء الراشدين؟','عمر بن عبد العزيز','الوليد بن عبد الملك','معاوية بن أبي سفيان','لعدله وزهده وحرصه على مصلحة الأمة.',4],
['من الخليفة الذي أنشأ أول مرصد فلكي؟','المأمون','هارون الرشيد','أبو جعفر المنصور','اهتم المأمون بالعلوم والفلك.',7],
['من الذي شيّد المسجد الأموي في دمشق؟','الوليد بن عبد الملك','عبد الملك بن مروان','معاوية بن أبي سفيان','شيّده الوليد، وبلغت الدولة في عهده أقصى اتساعها.',3],
['ما الذي أدى إلى سقوط الدولة العباسية نهائيًا؟','هجوم المغول على بغداد سنة ٦٥٦هـ','معركة الزاب الكبرى','فتح عمورية','سقطت بغداد في يد المغول.',8],
['من أسس مكتبة بيت الحكمة في بغداد؟','هارون الرشيد','عبد الملك بن مروان','معاوية بن أبي سفيان','أسسها الرشيد ودعمها المأمون.',7],
['كم عامًا تقريبًا امتد حكم الدولة الأموية؟','حوالي ٩١ عامًا','حوالي ٣٠ عامًا','أكثر من ٥ قرون','من ٤١ إلى ١٣٢هـ.',0]];
const TF=[['كان لأبي مسلم الخراساني دور في نجاح قيام الدولة العباسية.',1,'قاد الدعوة العباسية من خراسان.',5],['قام الخليفة العباسي هارون الرشيد بإنشاء سوق الوراقين.',1,'أنشأه الرشيد لنسخ الكتب وبيعها.',7],['استمرت الدولة العباسية أكثر من ستة قرون.',0,'استمرت أكثر من خمسة قرون (١٣٢–٦٥٦هـ).',8],['ازدهرت حركة الترجمة في العصر العباسي الثاني.',0,'ازدهرت في العصر العباسي الأول (الذهبي).',6],['قامت الدولة العباسية بعد هزيمة الأمويين في معركة الزاب الكبرى.',1,'كانت المعركة عام ١٣٢هـ.',5]];
const IM=[];
const O1=['معاوية بن أبي سفيان','عبد الملك بن مروان','الوليد بن عبد الملك','عمر بن عبد العزيز'];
let QZ=null,qi=0;
function startQuiz(){QZ=[...MC.map(m=>({k:'mc',q:m[0],c:m[1],o:shuf(m.slice(1,4)),e:m[4],u:m[5],a:null})),...TF.map(m=>({k:'mc',q:m[0],c:m[1]?'صح':'خطأ',o:['صح','خطأ'],e:m[2],u:m[3],a:null,tf:1})),...IM.map(m=>({k:'img',m:m[0],q:'ما اسم الخليفة؟',c:m[1],o:shuf(TY),e:'نوعها: '+m[1],u:m[2],a:null})),{k:'ord',q:'رتّب الخلفاء الأمويين زمنيًا من الأول للآخر',it:O1,a:mixed(O1),e:'الترتيب: '+O1.join(' ← '),u:1},{k:'ord',q:'رتّب الخلفاء العباسيين زمنيًا من الأول للآخر',it:PHS,a:mixed(PHS),e:'الترتيب: '+PHS.join(' ← '),u:6}];
 QZ.forEach(z=>{if(z.tf)z.o=['صح','خطأ']});qi=0;drawQ()}
function drawQ(){const z=QZ[qi],n=QZ.length;$('#qn').textContent=`${S.name} — السؤال ${qi+1} من ${n}`;$('#qp').style.width=(qi+1)/n*100+'%';
 $('#qd').innerHTML=QZ.map((q,i)=>`<button class="${q.a!==null?'an':''} ${i===qi?'cur':''}" data-q="${i}">${i+1}</button>`).join('');
 let h=`<h3>${z.q}</h3>`;if(z.k==='img')h+=`<div style="text-align:center">${moonSvg(z.m,120)}</div>`;
 if(z.k==='ord')h+='<ol class="ord" id="qo"></ol>';else h+=z.o.map(o=>`<button class="opt ${z.a===o?'sel':''}">${o}</button>`).join('');
 $('#qb').innerHTML=h;if(z.k==='ord')ordList($('#qo'),z.a);else $$('#qb .opt').forEach(b=>b.onclick=()=>{z.a=b.textContent;drawQ()});
 $('#qprev').disabled=!qi;$('#qnext').textContent=qi===n-1?'تسليم الاختبار':'التالي';$('#qwarn').textContent=''}
$('#qd').onclick=e=>{const b=e.target.closest('[data-q]');if(b){qi=+b.dataset.q;drawQ()}};
$('#qprev').onclick=()=>{qi--;drawQ()};
let warned=0;
$('#qnext').onclick=()=>{if(qi<QZ.length-1){qi++;warned=0;return drawQ()}
 const un=QZ.map((z,i)=>z.a===null?i+1:0).filter(Boolean);if(un.length&&!warned){warned=1;$('#qwarn').textContent='لسه مجاوبتش: '+un.join('، ')+' — اضغط تسليم تاني لو متأكد.';return}
 warned=0;const wrong=[];let ok=0;QZ.forEach(z=>{const r=z.k==='ord'?z.a.every((x,i)=>x===z.it[i]):z.a===z.c;if(r)ok++;else wrong.push(z)});
 const sc=Math.round(ok/QZ.length*100);S.q={score:sc,ok,wr:QZ.length-ok,wrong:wrong.map(z=>[z.q,z.k==='ord'?z.e:'الإجابة الصحيحة: '+z.c+' — '+z.e,z.u])};save();pushScore();go(7)};
function showResult(){const q=S.q;if(!q)return;const G=[[90,'ممتاز! فهمك للدرس رائع 🌟','🏆'],[75,'جيد جدًا! أنت قريب من الإتقان 👏','🎉'],[50,'جيد، وفيه أجزاء بسيطة تستحق المراجعة 💪','📜'],[0,'بداية طيبة! راجع الدرس وجرب تاني، وأنت قادر على التحسن 🚀','🔭']].find(g=>q.score>=g[0]);
 $('#rn').textContent=S.name;$('#rs').textContent=q.score+' / 100';$('#rm').textContent=G[1];$('#cel').textContent=G[2];$('#rev').textContent=G[1];
 $('#rstats').innerHTML=[['✅ الإجابات الصحيحة',q.ok],['❌ الإجابات الخاطئة',q.wr],['📊 النسبة المئوية',q.score+'%'],['⭐ نقاط اللعبة',S.g.pts],['🧭 إكمال الرحلة',Math.round(S.v.length/8*100)+'%']].map(x=>`<div class="card" style="text-align:center"><b>${x[0]}</b><div class="big" style="font-size:2rem">${x[1]}</div></div>`).join('');
 const us=[...new Set(q.wrong.map(w=>w[2]))];$('#rec').textContent=us.length?'راجع: '+us.map(i=>U[i][0]).join('، '):'مفيش حاجة تحتاج مراجعة، شغل ممتاز!';
 $('#wr').innerHTML=q.wrong.length?q.wrong.map(w=>`<p><b>${w[0]}</b><br><span class="lead">${w[1]}</span></p>`).join(''):'<p class="lead">كل إجاباتك صحيحة 🎉</p>'}
$('#rq').onclick=()=>{QZ=null;startQuiz();go(6)};
$('#rj').onclick=()=>{S.g={s:[0,0,0],pts:0,ok:0};S.q=null;S.v=[0];QZ=null;g2=0;seq=[];g3=null;save();go(2)};
// calm ambient music (generated in the browser)
if(typeof S.vol!=='number')S.vol=4;
let AC,master,filt,mT,mOn=false,ci=0;
const CH=[[73.42,220,277.18,369.99],[61.74,185,246.94,293.66],[49,196,246.94,370],[55,220,277.18,329.63]],PT=[0,1,2,3,2,1,3,2];
function tone(f,t0,d,ty,pk){const o=AC.createOscillator(),g=AC.createGain();o.type=ty;o.frequency.value=f;g.gain.setValueAtTime(0,t0);g.gain.linearRampToValueAtTime(pk,t0+d*.35);g.gain.linearRampToValueAtTime(0,t0+d);o.connect(g);g.connect(filt);o.start(t0);o.stop(t0+d+.1)}
function bell(f,t0){const o=AC.createOscillator(),o2=AC.createOscillator(),g=AC.createGain();o.frequency.value=f;o2.frequency.value=f*2.01;g.gain.setValueAtTime(0,t0);g.gain.linearRampToValueAtTime(.08,t0+.02);g.gain.exponentialRampToValueAtTime(.0005,t0+2.4);o.connect(g);o2.connect(g);g.connect(filt);o.start(t0);o2.start(t0);o.stop(t0+2.5);o2.stop(t0+2.5)}
function chord(){const t=AC.currentTime+.05,c=CH[ci++%4],N=[c[1]*2,c[2]*2,c[3]*2,c[2]*4];c.forEach(f=>tone(f,t,9,'sine',.07));tone(c[1],t,9,'triangle',.02);PT.forEach((k,i)=>{if(Math.random()<.8)bell(N[k],t+i)})}
function vol(){$('#vol').textContent=S.vol;if(master)master.gain.linearRampToValueAtTime(S.vol/10*.6,AC.currentTime+.2);save()}
$('#mp').onclick=()=>{if(!mOn){if(!AC){AC=new(window.AudioContext||window.webkitAudioContext)();master=AC.createGain();master.gain.value=0;filt=AC.createBiquadFilter();filt.type='lowpass';filt.frequency.value=3200;filt.connect(master);master.connect(AC.destination)}AC.resume();chord();mT=setInterval(chord,8000);mOn=true;vol()}else{clearInterval(mT);AC.suspend();mOn=false}$('#mp').setAttribute('aria-pressed',mOn);toast(mOn?'الموسيقى شغالة 🎵':'الموسيقى اتوقفت')};
$('#vp').onclick=()=>{S.vol=Math.min(10,S.vol+1);vol()};$('#vm').onclick=()=>{S.vol=Math.max(0,S.vol-1);vol()};
$('#vol').textContent=S.vol;
// leaderboard (shared when the db capability is available, otherwise local)
let DB=null,UID=null,LB=[];
const esc=s=>String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
function drawBoards(){const rows=DB?LB:(S.bd?[{uid:'me',name:S.name,g:S.bd.g,q:S.bd.q,total:S.bd.total}]:[]);
 const h=rows.length?`<ol class="ord">${rows.map((r,i)=>`<li style="${(DB?r.uid===UID:true)?'border-color:var(--ac)':''}"><span>${['🥇','🥈','🥉'][i]||(i+1)+'.'} <b>${esc(r.name)}</b></span><small>لعبة ${Number(r.g)||0} + اختبار ${Number(r.q)||0}</small><b>${Number(r.total)||0}</b></li>`).join('')}</ol>`:'<p class="lead">لسه مفيش نتائج. أكمل اللعبة والاختبار وهتظهر هنا.</p>';
 $$('#lb1,#lb2').forEach(e=>e.innerHTML=h+`<p class="lead" style="font-size:13px">${DB?'الترتيب حسب مجموع نقاط اللعبة + درجة الاختبار (أعلى نتيجة لكل طالب).':'اللوحة المشتركة غير متاحة هنا، فبتظهر نتيجتك على جهازك بس.'}</p>`)}
function pushScore(){const tot=S.g.pts+(S.q?S.q.score:0);if(!S.bd||tot>S.bd.total)S.bd={g:S.g.pts,q:S.q?S.q.score:0,total:tot};save();drawBoards();
 if(DB&&UID&&S.name)DB.doc('board/'+UID).set({uid:UID,name:S.name,g:S.bd.g,q:S.bd.q,total:S.bd.total}).catch(()=>{})}
(async()=>{try{DB=await claude.use('db');const u=await claude.use('user');UID=u?await u.id():null;if(DB&&UID)DB.collection('board').orderBy('total','desc').limit(20).onSnapshot(s=>{LB=s.docs.map(d=>d.data());drawBoards()},()=>{});else DB=null}catch(e){DB=null}drawBoards()})();
drawBoards();
drawSteps();go(0);
</script>
</body>
</html>
